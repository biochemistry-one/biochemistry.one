  "steps": [
    {
      "from": "可发酵多糖",
      "to": "乙酰辅酶A",
      "enzyme": "多步反应",
      "note": "淀粉、木聚糖等未被消化的多糖；经由丙酮酸"
    },
    {
      "from": "乙酰辅酶A",
      "to": "乙酰乙酰辅酶A",
      "enzyme": "硫解酶（Thl）",
      "cofactors": ["乙酰辅酶A"],
      "note": "两分子乙酰辅酶A缩合，释放辅酶A"
    },
    {
      "from": "乙酰乙酰辅酶A",
      "to": "3-羟丁酰辅酶A",
      "enzyme": "β-羟丁酰辅酶A脱氢酶（Hbd）"
    },
    {
      "from": "3-羟丁酰辅酶A",
      "to": "巴豆酰辅酶A",
      "enzyme": "巴豆酸酶（Cro）"
    },
    {
      "from": "巴豆酰辅酶A",
      "to": "丁酰辅酶A",
      "enzyme": "丁酰辅酶A脱氢酶-电子转移黄素蛋白复合物（Bcd-Etfαβ）",
      "cofactors": ["铁氧还蛋白"],
      "note": "4条丁酸合成途径共有此步；推测可保存能量"
    },
    {
      "from": "丁酰辅酶A",
      "to": "丁酸",
      "enzyme": "丁酰辅酶A:乙酸辅酶A转移酶（But）",
      "cofactors": ["乙酸→乙酰辅酶A"],
      "note": "替代途径：磷酸丁酰转移酶（Ptb）和丁酸激酶（Buk）"
    }
  ]
