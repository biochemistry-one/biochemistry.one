{
  "title": "Глюконеогенез из пирувата",
  "layout": "chain",
  "compartment": "Митохондриальный матрикс, цитозоль и эндоплазматический ретикулум клеток печени и коркового вещества почек",
  "steps": [
    {
      "from": "Пируват",
      "to": "Оксалоацетат",
      "enzyme": "Пируваткарбоксилаза (PC), митохондриальная",
      "cofactors": ["АТФ → АДФ", "HCO3−", "Биотин"],
      "note": "Аллостерический активатор — ацетил-КоА; на молекулу глюкозы — два пирувата"
    },
    {
      "from": "Оксалоацетат",
      "to": "Малат",
      "enzyme": "Малатдегидрогеназа 2 (MDH2), митохондриальная",
      "cofactors": ["НАДН → НАД+"],
      "reversible": true,
      "note": "Затем малат проходит через внутреннюю мембрану митохондрий"
    },
    {
      "from": "Малат",
      "to": "Оксалоацетат",
      "enzyme": "Малатдегидрогеназа 1 (MDH1), цитозольная",
      "cofactors": ["НАД+ → НАДН"],
      "reversible": true,
      "note": "Образует цитозольный НАДН, используемый GAPDH"
    },
    {
      "from": "Оксалоацетат",
      "to": "Фосфоенолпируват",
      "enzyme": "Фосфоенолпируваткарбоксикиназа 1 (PCK1), цитозольная",
      "cofactors": ["ГТФ → ГДФ"],
      "note": "Высвобождается CO2; PCK2 катализирует ту же реакцию в митохондриях"
    },
    {
      "from": "Фосфоенолпируват",
      "to": "2-Фосфоглицерат",
      "enzyme": "Енолаза 1 (ENO1)",
      "cofactors": ["H2O"],
      "reversible": true
    },
    {
      "from": "2-Фосфоглицерат",
      "to": "3-Фосфоглицерат",
      "enzyme": "Фосфоглицератмутаза 1 (PGAM1)",
      "reversible": true
    },
    {
      "from": "3-Фосфоглицерат",
      "to": "1,3-Бисфосфоглицерат",
      "enzyme": "Фосфоглицераткиназа 1 (PGK1)",
      "cofactors": ["АТФ → АДФ"],
      "reversible": true
    },
    {
      "from": "1,3-Бисфосфоглицерат",
      "to": "Глицеральдегид-3-фосфат",
      "enzyme": "Глицеральдегид-3-фосфатдегидрогеназа (GAPDH)",
      "cofactors": ["НАДН → НАД+"],
      "reversible": true,
      "note": "Высвобождается фосфат"
    },
    {
      "from": "Глицеральдегид-3-фосфат",
      "to": "Фруктозо-1,6-бисфосфат",
      "enzyme": "Альдолаза B (ALDOB)",
      "cofactors": ["Дигидроксиацетонфосфат (ДГАФ)"],
      "reversible": true,
      "note": "ДГАФ образуется из второй триозы под действием триозофосфатизомеразы (TPI1)"
    },
    {
      "from": "Фруктозо-1,6-бисфосфат",
      "to": "Фруктозо-6-фосфат",
      "enzyme": "Фруктозо-1,6-бисфосфатаза 1 (FBP1)",
      "cofactors": ["H2O"],
      "inhibitors": [{"name": "Фруктозо-2,6-бисфосфат"}, {"name": "АМФ"}],
      "note": "Высвобождается фосфат; глюкагон снижает уровень фруктозо-2,6-бисфосфата"
    },
    {
      "from": "Фруктозо-6-фосфат",
      "to": "Глюкозо-6-фосфат",
      "enzyme": "Глюкозо-6-фосфатизомераза (GPI)",
      "reversible": true
    },
    {
      "from": "Глюкозо-6-фосфат",
      "to": "Глюкоза",
      "enzyme": "Глюкозо-6-фосфатаза (G6PC1) эндоплазматического ретикулума",
      "cofactors": ["H2O"],
      "note": "SLC37A4 переносит субстрат в просвет ЭПР; высвобождается фосфат"
    }
  ]
}
