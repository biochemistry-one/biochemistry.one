{
  "title": "Цикл трикарбоновых кислот",
  "layout": "cycle",
  "compartment": "Митохондриальный матрикс; сукцинатдегидрогеназа — во внутренней мембране",
  "steps": [
    {
      "from": "Оксалоацетат",
      "to": "Цитрат",
      "enzyme": "Цитратсинтаза (CS)",
      "cofactors": ["Ацетил-КоА", "H2O"],
      "note": "Необратимое включение ацетильной группы; высвобождается КоА"
    },
    {
      "from": "Цитрат",
      "to": "Изоцитрат",
      "enzyme": "Аконитаза 2 (ACO2)",
      "cofactors": ["Кластер [4Fe-4S]"],
      "reversible": true,
      "note": "Через цис-аконитат"
    },
    {
      "from": "Изоцитрат",
      "to": "2-Оксоглутарат",
      "enzyme": "Изоцитратдегидрогеназа 3 (IDH3A, IDH3B, IDH3G)",
      "cofactors": ["НАД+ → НАДН", "Mg2+ или Mn2+"],
      "inhibitors": [{"name": "НАДН"}, {"name": "АТФ (в высоких концентрациях)"}],
      "note": "Высвобождается CO2; фермент активируют АДФ и цитрат"
    },
    {
      "from": "2-Оксоглутарат",
      "to": "Сукцинил-КоА",
      "enzyme": "2-Оксоглутаратдегидрогеназный комплекс (OGDH, DLST, DLD)",
      "cofactors": ["Тиаминпирофосфат", "Липоат", "КоА", "ФАД", "НАД+ → НАДН"],
      "inhibitors": [{"name": "НАДН"}, {"name": "АТФ"}],
      "note": "Высвобождается CO2; активность стимулируют Ca2+ и АДФ"
    },
    {
      "from": "Сукцинил-КоА",
      "to": "Сукцинат",
      "enzyme": "Сукцинил-КоА-синтетаза (SUCLG1 с SUCLG2 или SUCLA2)",
      "cofactors": ["ГДФ → ГТФ или АДФ → АТФ", "Фосфат"],
      "reversible": true,
      "note": "Высвобождается КоА; единственное субстратное фосфорилирование в цикле"
    },
    {
      "from": "Сукцинат",
      "to": "Фумарат",
      "enzyme": "Сукцинатдегидрогеназа, комплекс II (SDHA, SDHB, SDHC, SDHD)",
      "cofactors": ["Ковалентно связанный ФАД", "Убихинон → убихинол"],
      "note": "Передаёт электроны непосредственно в дыхательную цепь"
    },
    {
      "from": "Фумарат",
      "to": "Малат",
      "enzyme": "Фумаратгидратаза (FH)",
      "cofactors": ["H2O"],
      "reversible": true
    },
    {
      "from": "Малат",
      "to": "Оксалоацетат",
      "enzyme": "Малатдегидрогеназа 2 (MDH2)",
      "cofactors": ["НАД+ → НАДН"],
      "reversible": true,
      "note": "Эндергоническая; при работе цикла реакция смещается в прямом направлении"
    }
  ]
}
